FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/fluxgate-node ./cmd/fluxgate-node

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/fluxgate-node /app/fluxgate-node
COPY configs /app/configs
EXPOSE 8081 50051
ENTRYPOINT ["/app/fluxgate-node"]
