FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/fluxgate-allocator ./cmd/fluxgate-allocator

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/fluxgate-allocator /app/fluxgate-allocator
COPY configs /app/configs
EXPOSE 50050 8050
ENTRYPOINT ["/app/fluxgate-allocator"]
